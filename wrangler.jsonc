{
  "name": "vehicle-model-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QSS_STORE",
        "class_name": "QssStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QssContainer"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["QssContainer"],
      "new_sqlite_classes": ["QssStore"]
    }
  ]
}
